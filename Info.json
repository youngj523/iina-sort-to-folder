{
  "name": "Sort to Folder",
  "identifier": "io.github.youngj523.sort-to-folder",
  "version": "2.0.4",
  "ghRepo": "youngj523/iina-sort-to-folder",
  "ghVersion": 9,
  "description": "Adds on-screen buttons that move the video being played into a chosen folder and then play the next one.",
  "author": {
    "name": "youngj523",
    "url": "https://github.com/youngj523/iina-sort-to-folder"
  },
  "entry": "main.js",
  "globalEntry": "global.js",
  "preferencesPage": "preferences.html",
  "preferenceDefaults": {
    "folderCount": 0,
    "dir1": "",
    "label1": "",
    "key1": "Ctrl+1",
    "dir2": "",
    "label2": "",
    "key2": "Ctrl+2",
    "dir3": "",
    "label3": "",
    "key3": "Ctrl+3",
    "dir4": "",
    "label4": "",
    "key4": "Ctrl+4",
    "dir5": "",
    "label5": "",
    "key5": "Ctrl+5",
    "dir6": "",
    "label6": "",
    "key6": "Ctrl+6",
    "dir7": "",
    "label7": "",
    "key7": "Ctrl+7",
    "dir8": "",
    "label8": "",
    "key8": "Ctrl+8",
    "dir9": "",
    "label9": "",
    "key9": "Ctrl+9",
    "dir10": "",
    "label10": "",
    "key10": "Ctrl+0",
    "keyUndo": "Ctrl+z",
    "showButtons": true,
    "position": "middle-right",
    "pickRequest": ""
  },
  "permissions": [
    "show-osd",
    "video-overlay",
    "file-system"
  ]
}

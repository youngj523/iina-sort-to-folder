{
  "name": "Sort to Folder",
  "identifier": "io.github.youngj523.sort-to-folder",
  "version": "1.2.1",
  "ghRepo": "youngj523/iina-sort-to-folder",
  "ghVersion": 4,
  "description": "Adds two on-screen buttons that move the video being played into a chosen folder and then play the next one.",
  "author": {
    "name": "youngj523",
    "url": "https://github.com/youngj523/iina-sort-to-folder"
  },
  "entry": "main.js",
  "preferencesPage": "preferences.html",
  "preferenceDefaults": {
    "dir1": "",
    "dir2": "",
    "label1": "",
    "label2": "",
    "showButtons": true,
    "position": "middle-right",
    "key1": "Ctrl+1",
    "key2": "Ctrl+2",
    "keyUndo": "Ctrl+z"
  },
  "permissions": [
    "show-osd",
    "video-overlay",
    "file-system"
  ]
}

{
  "name": "Sort to Folder",
  "identifier": "io.github.youngj523.sort-to-folder",
  "version": "1.0.0",
  "ghRepo": "youngj523/iina_plugin",
  "ghVersion": 1,
  "description": "在播放畫面上顯示兩個按鈕，一鍵把目前播放的影片移動到指定資料夾，並自動播放下一部。",
  "author": {
    "name": "youngj523",
    "url": "https://github.com/youngj523/iina_plugin"
  },
  "entry": "main.js",
  "preferencesPage": "preferences.html",
  "preferenceDefaults": {
    "dir1": "",
    "dir2": "",
    "label1": "",
    "label2": "",
    "showButtons": true
  },
  "permissions": ["show-osd", "video-overlay", "file-system"]
}
